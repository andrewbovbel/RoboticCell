    "# ============================================================\n",
    "# 1. SET UP MODEL AND PARAMETERS\n",
    "# ============================================================\n",
    "\n",
    "seed = 42\n",
    "rng = np.random.default_rng(seed)\n",
    "\n",
    "cp_model = CpoModel()\n",
    "\n",
    "n = 3                       # number of jobs\n",
    "m = 2                       # number of machines\n",
    "\n",
    "J = list(range(1, n + 1))   # jobs: 1, 2, 3\n",
    "M = list(range(1, m + 1))   # machines: 1, 2\n",
    "\n",
    "# Processing times: rows = machines, columns = jobs\n",
    "p = rng.integers(1, 11, size=(m, n))\n",
    "\n",
    "# Travel times between consecutive machines\n",
    "# Rows = machine transitions, columns = jobs\n",
    "tau = rng.integers(1, 11, size=(m - 1, n))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. DETERMINE A FEASIBLE TIME HORIZON (UPPER BOUND)\n",
    "# ============================================================\n",
    "\n",
    "machine_available = [0] * m\n",
    "\n",
    "for j in J:\n",
    "    previous_completion = 0\n",
    "\n",
    "    for i in range(m):\n",
    "\n",
    "        if i == 0:\n",
    "            arrival = 0\n",
    "        else:\n",
    "            arrival = (\n",
    "                previous_completion\n",
    "                + int(tau[i - 1, j - 1])\n",
    "            )\n",
    "\n",
    "        start_time = max(machine_available[i], arrival)\n",
    "\n",
    "        finish_time = start_time + int(p[i, j - 1])\n",
    "\n",
    "        machine_available[i] = finish_time\n",
    "\n",
    "        previous_completion = finish_time\n",
    "\n",
    "H = int(np.sum(p) + np.sum(tau)) # max(machine_available)\n",
    "\n",
    "T = range(H + 1)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. CREATE INTERVAL VARIABLES\n",
    "# ============================================================\n",
    "\n",
    "# Each interval represents one job processing on one machine.\n",
    "# CPLEX determines the start and end times automatically.\n",
    "\n",
    "intervals = {}\n",
    "\n",
    "for i in M:\n",
    "    for j in J:\n",
    "\n",
    "        processing_time = int(p[i - 1, j - 1])\n",
    "\n",
    "        intervals[i, j] = cp_model.interval_var(\n",
    "            start=(0, H - processing_time),\n",
    "            size=processing_time,\n",
    "            name=f\"job_{j}_machine_{i}\"\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. CONSTRAINT 1: MACHINE CAPACITY\n",
    "# ============================================================\n",
    "\n",
    "# Each machine can process at most one job at a time.\n",
    "\n",
    "for i in M:\n",
    "\n",
    "    cp_model.add(\n",
    "        cp_model.no_overlap(\n",
    "            [intervals[i, j] for j in J]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. CONSTRAINT 2: TRAVEL-TIME PRECEDENCE\n",
    "# ============================================================\n",
    "\n",
    "# Job j must finish processing on machine i\n",
    "# and complete its travel before starting on machine i+1.\n",
    "\n",
    "for i in M[:-1]:\n",
    "    for j in J:\n",
    "\n",
    "        travel_time = int(tau[i - 1, j - 1])\n",
    "\n",
    "        cp_model.add(\n",
    "            cp_model.end_before_start(\n",
    "                intervals[i, j],\n",
    "                intervals[i + 1, j],\n",
    "                travel_time\n",
    "            )\n",
    "        )\n",
    "\n",
    "# ============================================================\n",
    "# 4. BLOCKING: CREATE MACHINE OCCUPANCY INTERVALS\n",
    "# ============================================================\n",
    "\n",
    "occupancy = {}\n",
    "\n",
    "for i in M[:-1]:\n",
    "    for j in J:\n",
    "\n",
    "        occupancy[i, j] = cp_model.interval_var(\n",
    "            start=(0, H),\n",
    "            end=(0, H),\n",
    "            name=f\"occupancy_{i}_{j}\"\n",
    "        )\n",
    "\n",
    "        # Occupancy starts when processing starts\n",
    "        cp_model.add(\n",
    "            cp_model.start_at_start(\n",
    "                occupancy[i, j],\n",
    "                intervals[i, j]\n",
    "            )\n",
    "        )\n",
    "\n",
    "        # Occupancy cannot end before processing completes\n",
    "        cp_model.add(\n",
    "            cp_model.end_before_end(\n",
    "                intervals[i, j],\n",
    "                occupancy[i, j]\n",
    "            )\n",
    "        )\n",
    "\n",
    "        # Next operation starts after the job leaves\n",
    "        # the current machine and completes transportation\n",
    "        cp_model.add(\n",
    "            cp_model.end_of(occupancy[i, j])\n",
    "            + int(tau[i - 1, j - 1])\n",
    "            == cp_model.start_of(intervals[i + 1, j])\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. MACHINE CAPACITY INCLUDING BLOCKING\n",
    "# ============================================================\n",
    "\n",
    "# Intermediate machines:\n",
    "# A job occupies the machine until it leaves for the next machine.\n",
    "\n",
    "for i in M[:-1]:\n",
    "\n",
    "    cp_model.add(\n",
    "        cp_model.no_overlap(\n",
    "            [occupancy[i, j] for j in J]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# Last machine:\n",
    "# A job occupies the machine until processing completes.\n",
    "\n",
    "cp_model.add(\n",
    "    cp_model.no_overlap(\n",
    "        [intervals[m, j] for j in J]\n",
    "    )\n",
    ")\n",
    "\n",
    "# ============================================================\n",
    "# 6. OBJECTIVE FUNCTION: MINIMIZE MAKESPAN\n",
    "# ============================================================\n",
    "\n",
    "makespan = cp_model.max(\n",
    "    [cp_model.end_of(intervals[m, j]) for j in J]\n",
    ")\n",
    "\n",
    "cp_model.minimize(makespan)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PRINT MODEL INFORMATION\n",
    "# ============================================================\n",
    "\n",
    "print(\"Number of jobs:\", n)\n",
    "print(\"Number of machines:\", m)\n",
    "print(\"Time horizon:\", H)\n",
    "\n",
    "print(\"Number of interval variables:\", m * n)\n",
    "\n",
    "print(\"Processing times:\\n\", p)\n",
    "print(\"Travel times:\\n\", tau)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. SOLVE MODEL\n",
    "# ============================================================\n",
    "\n",
