      "source": [
        "# Paper toy instance (Fig. 1): m=3 machines, n=4 jobs, RCP optimum 553.\n",
        "# This CP is a flow-shop with consecutive travel only (no single-robot contention),\n",
        "# so it is a relaxation of the robotic cell; the makespan can be below 553.\n",
        "import sys\n",
        "from pathlib import Path\n",
        "\n",
        "ROOT = Path.cwd().resolve()\n",
        "sys.path.insert(0, str(ROOT))\n",
        "from instance.instance_reader import read_instance\n",
        "\n",
        "INSTANCE = ROOT / \"instance\" / \"paper_sample_instance.txt\"\n",
        "m_paper, n_paper, p_pad, tau_st = read_instance(INSTANCE)\n",
        "\n",
        "cp_model = CpoModel()\n",
        "\n",
        "n = n_paper  # jobs\n",
        "m = m_paper  # machines\n",
        "\n",
        "J = list(range(1, n + 1))\n",
        "M = list(range(1, m + 1))\n",
        "\n",
        "# processing time of job j on machine i; rows = machines, columns = jobs\n",
        "p = np.array([[p_pad[i][j] for j in J] for i in M], dtype=int)\n",
        "\n",
        "# travel time from machine i to i+1 (paper τ, same for every job)\n",
        "tau = np.array(\n",
        "    [[tau_st[i][i + 1] for _ in J] for i in range(1, m)],\n",
        "    dtype=int,\n",
        ")\n",
        "\n",
        "# greedy flow-shop schedule as a time-horizon UB (this CP has no single-robot constraint)\n",
        "machine_available = [0] * m\n",
        "for j in J:\n",
        "    previous_completion = 0\n",
        "    for i in range(m):\n",
        "        arrival = 0 if i == 0 else previous_completion + int(tau[i - 1, j - 1])\n",
        "        start_time = max(machine_available[i], arrival)\n",
        "        finish_time = start_time + int(p[i, j - 1])\n",
        "        machine_available[i] = finish_time\n",
        "        previous_completion = finish_time\n",
        "H = max(machine_available)\n",
        "T = range(H)  # time periods: 0, 1, ..., H-1\n",
        "\n",
        "# starting time of job j on machine i\n",
        "s = {\n",
        "    (i, j): cp_model.integer_var(\n",
        "        min=0,\n",
        "        max=H,\n",
        "        name=f\"s_{i}{j}\"\n",
        "    )\n",
        "    for i in M\n",
        "    for j in J\n",
        "}\n",
        "\n",
        "# completion time of job j on machine i\n",
        "c = {\n",
        "    (i, j): s[i, j] + int(p[i-1, j-1])\n",
        "    for i in M\n",
        "    for j in J\n",
        "}\n",
        "\n",
        "\n",
        "# binary decision variable x_ijt:\n",
        "# 1 if job j starts processing on machine i at time t\n",
        "# 0 otherwise\n",
        "x = {\n",
        "    (i, j, t): cp_model.binary_var(\n",
        "        name=f\"x_{i}{j}{t}\"\n",
        "    )\n",
        "    for i in M\n",
        "    for j in J\n",
        "    for t in T\n",
        "}\n",
        "\n",
        "# constraint 2: very job starts exactly once on each machine\n",
        "for i in M:\n",
        "    for j in J:\n",
        "        cp_model.add(\n",
        "            cp_model.sum(\n",
        "                x[i, j, t] for t in T\n",
        "            ) == 1\n",
        "        )\n",
        "\n",
        "# constraint 2: each machine processes at most one job at a time\n",
        "for i in M:\n",
        "    for t in T:\n",
        "        cp_model.add(\n",
        "            cp_model.sum(\n",
        "                x[i, j, t_prime]\n",
        "                for j in J\n",
        "                for t_prime in range(\n",
        "                    max(0, t - int(p[i-1, j-1]) + 1),\n",
        "                    t + 1\n",
        "                )\n",
        "            ) <= 1\n",
        "        )\n",
        "\n",
        "# link starting times to binary dec var\n",
        "for i in M:\n",
        "    for j in J:\n",
        "        cp_model.add(\n",
        "            s[i, j] == cp_model.sum(\n",
        "                t * x[i, j, t] for t in T\n",
        "            )\n",
        "        )\n",
        "\n",
        "# constraint _: ensure all jobs finish within the time horizon \n",
        "# not sure if we need this\n",
        "for i in M:\n",
        "    for j in J:\n",
        "        cp_model.add(c[i, j] <= H)\n",
        "\n",
        "# constraint 4: job j must finish on machine i and travel before starting on machine i+1\n",
        "for i in M[:-1]:\n",
        "    for j in J:\n",
        "        cp_model.add(\n",
        "            c[i, j] + int(tau[i-1, j-1])\n",
        "            <= s[i+1, j]\n",
        "        )\n",
        "\n",
        "# # Constraint 5: Set x equal to 1 at time 0 -- constraint 5 doesn't seem right in that the jobs probably shouldn't ALL start at t = 0\n",
        "\n",
        "# for i in M:\n",
        "#     for j in J:\n",
        "#         cp_model.add(x[i, j, 0] == 1)\n",
        "\n",
        "# constraint 6: set processing times of dummy machines to zero\n",
        "p_extended = np.zeros((m + 2, n), dtype=int)\n",
        "\n",
        "# copy actual processing times into the middle rows\n",
        "p_extended[1:m+1, :] = p\n",
        "\n",
        "# minimize flow-shop makespan (last machine completion). RCP paper optimum is 553.\n",
        "makespan = cp_model.integer_var(min=0, max=H, name=\"makespan\")\n",
        "for j in J:\n",
        "    cp_model.add(c[m, j] <= makespan)\n",
        "cp_model.add(cp_model.minimize(makespan))\n",
        "\n",
        "print(\"Instance:\", INSTANCE)\n",
        "print(\"Number of jobs:\", n)\n",
        "print(\"Number of machines:\", m)\n",
        "print(\"Time horizon:\", H)\n",
        "print(\"Number of binary decision variables:\", m * n * H)\n",
        "print(\"Processing times:\\n\", p)\n",
        "print(\"Travel times:\\n\", tau)\n",
        ""
      ],
